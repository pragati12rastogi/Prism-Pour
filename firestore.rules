rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Validation Blueprint: UserProgress
    function isValidUserProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'unlockedLevel',
          'currentLevel',
          'coins',
          'dailyRewardCount',
          'lastDailyRewardAt',
          'muted',
          'colorblindMode',
          'bestMovesByLevel',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'unlockedLevel',
          'currentLevel',
          'coins',
          'dailyRewardCount',
          'lastDailyRewardAt',
          'muted',
          'colorblindMode',
          'bestMovesByLevel',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.unlockedLevel is int
        && data.unlockedLevel >= 1
        && data.unlockedLevel <= 10000
        && data.currentLevel is int
        && data.currentLevel >= 1
        && data.currentLevel <= 10000
        && data.coins is int
        && data.coins >= 0
        && data.coins <= 10000000
        && data.dailyRewardCount is int
        && data.dailyRewardCount >= 0
        && data.dailyRewardCount <= 100000
        && (data.lastDailyRewardAt == null || data.lastDailyRewardAt is timestamp)
        && data.muted is bool
        && data.colorblindMode is bool
        && data.bestMovesByLevel is map
        && data.bestMovesByLevel.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isClaimDailyRewardAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'coins',
          'lastDailyRewardAt',
          'dailyRewardCount',
          'updatedAt'
        ])
        && incoming().lastDailyRewardAt == request.time
        && incoming().updatedAt == request.time
        && incoming().dailyRewardCount == existing().dailyRewardCount + 1
        && incoming().coins == existing().coins + 50
        && (
          existing().lastDailyRewardAt == null ||
          request.time >= existing().lastDailyRewardAt + duration.value(24, 'h')
        );
    }

    function isSaveProgressAction() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'unlockedLevel',
          'currentLevel',
          'coins',
          'bestMovesByLevel',
          'muted',
          'colorblindMode',
          'updatedAt'
        ])
        && incoming().updatedAt == request.time
        && incoming().unlockedLevel >= existing().unlockedLevel
        && incoming().coins <= existing().coins + 35
        && incoming().lastDailyRewardAt == existing().lastDailyRewardAt
        && incoming().dailyRewardCount == existing().dailyRewardCount;
    }

    // Validation Blueprint: ActiveGameSession
    function isValidActiveGameSession(data, userId) {
      return data.keys().hasAll([
          'uid',
          'level',
          'parMoves',
          'extraBottlesAdded',
          'bottles',
          'initialBottles',
          'history',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'level',
          'parMoves',
          'extraBottlesAdded',
          'bottles',
          'initialBottles',
          'history',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.level is int
        && data.level >= 1
        && data.level <= 10000
        && data.parMoves is int
        && data.parMoves >= 1
        && data.parMoves <= 500
        && data.extraBottlesAdded is int
        && data.extraBottlesAdded >= 0
        && data.extraBottlesAdded <= 2
        && data.bottles is list
        && data.bottles.size() >= 3
        && data.bottles.size() <= 16
        && data.bottles[0] is map
        && data.initialBottles is list
        && data.initialBottles.size() >= 3
        && data.initialBottles.size() <= 16
        && data.initialBottles[0] is map
        && data.history is list
        && data.history.size() <= 500
        && (data.history.size() == 0 || data.history[0] is map)
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().coins <= 10000
        && incoming().dailyRewardCount == 0
        && incoming().lastDailyRewardAt == null;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (isClaimDailyRewardAction() || isSaveProgressAction());

      allow delete: if false;

      // Subcollection: /users/{userId}/sessions/{sessionId}
      match /sessions/{sessionId} {
        allow get: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId);

        allow list: if isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && sessionId == 'current'
          && isOwner(userId)
          && isValidActiveGameSession(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(sessionId)
          && sessionId == 'current'
          && isOwner(userId)
          && isValidActiveGameSession(incoming(), userId)
          && incoming().uid == existing().uid
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId);
      }
    }
  }
}
